{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Windows Tablet Launcher",
  "version": "0.2.0",
  "identifier": "com.huanchen.windows-tablet-launcher",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Windows Tablet Launcher",
        "width": 1440,
        "minWidth": 960,
        "height": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": true,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
