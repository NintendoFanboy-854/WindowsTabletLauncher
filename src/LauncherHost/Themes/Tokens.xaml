<?xml version="1.0" encoding="utf-8" ?>
<!--
  Fluent 2 / WinUI 3 设计令牌（唯一自定义令牌源）
  - 画刷仅补充 WinUI 未提供的语义（磁贴面、弹层面）；其余一律引用系统主题资源
  - 字阶/几何常量与 Fluent 工厂（SharedUtils.Fluent）保持同一套数值
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="Tile.BackgroundBrush" Color="#F3F3F3" />
            <SolidColorBrush x:Key="Tile.StrokeBrush" Color="#0F000000" />
            <SolidColorBrush x:Key="Overlay.SurfaceBrush" Color="#F3F3F3" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="Tile.BackgroundBrush" Color="#2B2B2B" />
            <SolidColorBrush x:Key="Tile.StrokeBrush" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="Overlay.SurfaceBrush" Color="#2B2B2B" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="Tile.BackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="Tile.StrokeBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="Overlay.SurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- 几何令牌：4px 网格 -->
    <x:Double x:Key="TouchTarget">44</x:Double>
    <x:Double x:Key="RadiusControl">4</x:Double>
    <x:Double x:Key="RadiusCard">8</x:Double>
    <x:Double x:Key="RadiusOverlay">8</x:Double>
    <x:Double x:Key="SpaceXS">4</x:Double>
    <x:Double x:Key="SpaceS">8</x:Double>
    <x:Double x:Key="SpaceM">12</x:Double>
    <x:Double x:Key="SpaceL">16</x:Double>
    <x:Double x:Key="SpaceXL">24</x:Double>

    <!-- 字阶：Caption 12/16 · Body 14/20 · BodyLarge 18/24 · Subtitle 20/28 · Title 28/36；数字两档 48/56 · 68/76 -->
    <x:Double x:Key="FontCaption">12</x:Double>
    <x:Double x:Key="FontBody">14</x:Double>
    <x:Double x:Key="FontBodyLarge">18</x:Double>
    <x:Double x:Key="FontSubtitle">20</x:Double>
    <x:Double x:Key="FontTitle">28</x:Double>
    <x:Double x:Key="NumberTileSize">48</x:Double>
    <x:Double x:Key="NumberTileLine">56</x:Double>
    <x:Double x:Key="NumberHeroSize">68</x:Double>
    <x:Double x:Key="NumberHeroLine">76</x:Double>

    <!-- 字阶样式 -->
    <Style x:Key="CaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineHeight" Value="16" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style x:Key="BodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>
    <Style x:Key="BodyStrongTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>
    <Style x:Key="BodyLargeTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="LineHeight" Value="24" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>
    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="LineHeight" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>
    <Style x:Key="SubtitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="LineHeight" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>
    <Style x:Key="TitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="LineHeight" Value="36" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>
    <Style x:Key="NumberTileTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="48" />
        <Setter Property="LineHeight" Value="56" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>
    <Style x:Key="NumberHeroTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="68" />
        <Setter Property="LineHeight" Value="76" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>

    <!-- 控件样式：触控目标一律 ≥44×44 epx -->
    <Style x:Key="IconButtonStyle" TargetType="Button">
        <Setter Property="MinWidth" Value="44" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
    </Style>

    <!-- 隐式 TextBox 样式：44px 触控高度 + Padding 使占位符/文本竖向居中
         （默认模板内容元素顶对齐，加高后文字会贴顶，用对称 Padding 校正） -->
    <Style TargetType="TextBox">
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="10,11,10,11" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style x:Key="CtaAccentStyle" TargetType="Button">
        <Setter Property="MinWidth" Value="120" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="16,8,16,8" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
    </Style>
    <Style x:Key="CtaSecondaryStyle" TargetType="Button">
        <Setter Property="MinWidth" Value="120" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="16,8,16,8" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
    </Style>

    <!-- 表面样式 -->
    <Style x:Key="OverlayCardStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="{ThemeResource Overlay.SurfaceBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="Padding" Value="24" />
    </Style>
    <Style x:Key="InnerCardStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="Padding" Value="16" />
    </Style>
    <Style x:Key="StatTileStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="Padding" Value="12,8,12,8" />
    </Style>
</ResourceDictionary>
