<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="LauncherHost.Controls.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="设置"
    mc:Ignorable="d">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">760</x:Double>
    </ContentDialog.Resources>

    <Grid Width="720" Height="460" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListView
                x:Name="NavList"
                Grid.Column="0"
                SelectionMode="Single"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                CornerRadius="8" />

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <ContentControl
                    x:Name="DetailHost"
                    HorizontalContentAlignment="Stretch"
                    Padding="4,0,4,0">
                    <StackPanel x:Name="GlobalPanel" Spacing="12">
                        <ComboBox x:Name="LanguageCombo" Header="语言" HorizontalAlignment="Stretch">
                            <ComboBoxItem Tag="zh-cn">中文</ComboBoxItem>
                            <ComboBoxItem Tag="en-us">English</ComboBoxItem>
                        </ComboBox>
                        <ComboBox x:Name="ThemeCombo" Header="主题" HorizontalAlignment="Stretch">
                            <ComboBoxItem Tag="Default">跟随系统</ComboBoxItem>
                            <ComboBoxItem Tag="Light">浅色</ComboBoxItem>
                            <ComboBoxItem Tag="Dark">深色</ComboBoxItem>
                        </ComboBox>
                    <ToggleSwitch x:Name="EditModeToggle" Header="编辑模式" />
                    <NumberBox
                        x:Name="NotifySecondsBox"
                        Header="通知升级等待（秒）"
                        Minimum="1"
                        Maximum="120"
                        SpinButtonPlacementMode="Inline" />
                    <ComboBox x:Name="SettingsPageCombo" Header="设置按钮所在页面" HorizontalAlignment="Left" MinWidth="120" />
                    <Border Margin="0,4,0,0" Padding="0" />
                    <Expander x:Name="AiExpander" Header="AI 设置" IsExpanded="False">
                        <StackPanel Spacing="12" Margin="0,8,0,0">
                            <ComboBox x:Name="ProviderCombo" Header="服务提供商" HorizontalAlignment="Stretch">
                                <ComboBoxItem Tag="deepseek">DeepSeek</ComboBoxItem>
                                <ComboBoxItem Tag="mimo">MiMo</ComboBoxItem>
                            </ComboBox>
                            <TextBox x:Name="ApiKeyBox" PlaceholderText="sk-…" HorizontalAlignment="Stretch" />
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <ComboBox x:Name="ModelCombo" Header="AI 模型" MinWidth="140" />
                                <ComboBox x:Name="ThinkingCombo" Header="思考档位" MinWidth="100" />
                            </StackPanel>
                            <ToggleSwitch x:Name="ExpandCotToggle" Header="展开思维链与工具调用" />
                            <ToggleSwitch x:Name="VoiceAutoToggle" Header="语音自动聆听" Visibility="Collapsed" />
                            <NumberBox x:Name="SilenceFramesBox" Header="无人脸停止聆听(帧)" Minimum="5" Maximum="120" SpinButtonPlacementMode="Inline" Visibility="Collapsed" />
                            <NumberBox x:Name="CaptureIntervalBox" Header="人脸检测间隔(秒)" Minimum="1" Maximum="10" SpinButtonPlacementMode="Inline" Visibility="Collapsed" />
                            <StackPanel x:Name="FaceSection" Spacing="6" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <TextBlock x:Name="FaceStatusLabel" Text="人脸: 未注册" FontSize="12" VerticalAlignment="Center" Opacity="0.7" />
                                    <Button x:Name="RegisterFaceBtn" Content="注册人脸" FontSize="11" Height="28" Padding="8,0" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock x:Name="MemoryLabel" Text="AI 记忆: 0 条" FontSize="12" VerticalAlignment="Center" Opacity="0.7" />
                                <Button x:Name="ViewMemoryBtn" Content="查看" FontSize="11" Width="48" Height="28" Padding="0" />
                                <Button x:Name="ClearMemoryBtn" Content="清除" FontSize="11" Width="48" Height="28" Padding="0" />
                            </StackPanel>
                            <ScrollViewer x:Name="MemoryScroll" MaxHeight="120" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                                <TextBlock x:Name="MemoryContent" TextWrapping="Wrap" FontSize="12" Opacity="0.8" />
                            </ScrollViewer>
                        </StackPanel>
                    </Expander>

                    <Button
                        x:Name="ResetButton"
                        Content="重置所有设置与布局"
                        Margin="0,12,0,0"
                        HorizontalAlignment="Stretch">
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackground" Color="#CC0000" />
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#B00000" />
                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#990000" />
                            <SolidColorBrush x:Key="ButtonForeground" Color="White" />
                            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
                            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White" />
                        </Button.Resources>
                    </Button>
                </StackPanel>
                </ContentControl>
            </ScrollViewer>
        </Grid>

        <StackPanel
            Grid.Row="1"
            Orientation="Horizontal"
            HorizontalAlignment="Center"
            Spacing="48">
            <Button x:Name="CloseButton" Content="关闭" MinWidth="120" />
            <Button x:Name="ExitButton" Content="退出启动器" MinWidth="120"
                    Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>
    </Grid>
</ContentDialog>
