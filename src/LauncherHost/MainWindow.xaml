<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="LauncherHost.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Windows Tablet Launcher"
    mc:Ignorable="d">
    <Grid>
        <FlipView x:Name="Pager" Background="Transparent" />

        <Button x:Name="EditExitBtn"
                Width="44" Height="44"
                Padding="0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="16"
                CornerRadius="22"
                AutomationProperties.Name="退出编辑模式"
                Visibility="Collapsed">
            <FontIcon Glyph="&#xE73E;" FontSize="14" />
        </Button>

        <StackPanel
            x:Name="BottomBar"
            Orientation="Horizontal"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="0,0,0,16"
            Spacing="16">
            <PipsPager x:Name="Pips" Visibility="Collapsed" />
            <TextBox x:Name="AgentInput"
                     PlaceholderText="问AI..."
                     Width="240"
                     MinHeight="44"
                     VerticalAlignment="Center"
                     AutomationProperties.Name="向 AI 提问" />
            <Button x:Name="MicBtn"
                    Width="44" Height="44"
                    Padding="0"
                    VerticalAlignment="Center"
                    CornerRadius="22"
                    AutomationProperties.Name="语音输入"
                    ToolTipService.ToolTip="语音输入">
                <FontIcon Glyph="&#xE1D6;" FontSize="16" />
            </Button>
            <Button x:Name="AgentSendBtn"
                    Content="发送"
                    FontSize="14"
                    MinWidth="72" MinHeight="44"
                    Padding="16,8,16,8"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="发送" />
        </StackPanel>
    </Grid>
</Window>
