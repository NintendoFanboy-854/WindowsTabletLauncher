{
  "id": "todo",
  "name": "待办",
  "version": "2.0.0",
  "identityHue": "purple",
  "background": true,
  "widgets": [
    {
      "id": "todo-list",
      "title": "待办",
      "sizes": [
        [1, 1],
        [2, 2],
        [3, 2],
        [3, 3],
        [4, 2]
      ],
      "defaultSize": [3, 3],
      "cell": [0, 2],
      "size": [3, 3]
    }
  ],
  "settings": {
    "key": "settings",
    "version": 1,
    "groups": [
      {
        "id": "display",
        "title": "显示与行为",
        "hint": "长期偏好；修改后宿主立即保存并生效",
        "fields": [
          {
            "key": "showCompleted",
            "type": "boolean",
            "label": "显示已完成",
            "description": "在列表视图底部折叠显示已完成任务",
            "default": true
          },
          {
            "key": "defaultSort",
            "type": "enum",
            "label": "默认排序",
            "description": "卡片与详情列表的初始排序方式",
            "default": "manual",
            "options": [
              { "value": "manual", "label": "手动" },
              { "value": "due", "label": "截止时间" },
              { "value": "priority", "label": "优先级" },
              { "value": "created", "label": "创建时间" }
            ]
          },
          {
            "key": "weekStart",
            "type": "enum",
            "label": "一周起始日",
            "description": "影响日历、周视图、月视图与热力图",
            "default": 1,
            "options": [
              { "value": 1, "label": "周一" },
              { "value": 0, "label": "周日" }
            ]
          }
        ]
      }
    ]
  }
}
